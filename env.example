# Copie para .env.local (no seu computador) ou cadastre na Vercel em
# Settings > Environment Variables. Os dois valores ficam no Supabase em
# Project Settings > API (ou "Connect").
# Sem estas variáveis o site roda em MODO DEMONSTRAÇÃO (dados só na memória).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public
